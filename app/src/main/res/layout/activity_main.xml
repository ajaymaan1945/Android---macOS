<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:id="@+id/appTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAAN" android:textSize="34sp" android:textStyle="bold" />
        <TextView android:id="@+id/appSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your phone, connected to your Mac." android:textSize="15sp" android:alpha="0.65" android:layout_marginBottom="20dp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="26dp" app:strokeWidth="1dp" android:layout_marginBottom="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/connectionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Looking for your Mac" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:id="@+id/deviceName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Automatic discovery is enabled" android:textSize="14sp" android:alpha="0.65" android:layout_marginTop="5dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quick actions" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="10dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/screenButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="Screen sharing" android:layout_marginBottom="10dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/filesButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="Send a file to Mac" android:layout_marginBottom="10dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/fileBridgeButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="MAAN Files — drag to Mac" android:layout_marginBottom="10dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/settingsButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="Settings" android:layout_marginBottom="20dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Services" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/callServiceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calls   •   ON" android:textSize="16sp" android:padding="12dp" />
            <TextView android:id="@+id/clipboardServiceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clipboard   •   ON" android:textSize="16sp" android:padding="12dp" />
            <TextView android:id="@+id/fileServiceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="File transfer   •   ON" android:textSize="16sp" android:padding="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
